{literal}
body, div, td, input {
    FONT-FAMILY: Verdana, Arial, Helvetica, Sans-serif;
    color: rgb(0, 0, 0);
    font-size: 12px
}


h1 {
    font-size: 16px;
    margin-bottom: 4px;
    margin-top: 0
}

h2 {
    font-size: 13px
}

html, body {
    height: 100%;
    margin: 0;
    padding: 0
}
table, img {
    border: 0
}

A.top_links:link {
    font-family: Verdana;
    TEXT-DECORATION: none;
    COLOR: #2b2b2b;
    font-size: 11px;
}

#nav-searchbar {
    box-sizing: border-box;
    display: block;
    overflow: hidden;
    position: relative;
    white-space: nowrap;
    width: auto
}

#nav-searchbar .nav-submit-button {
    box-sizing: border-box;
    display: inline-block;
    float: right;
    height: 23px;
    overflow: hidden;
    position: relative;
    width: 24px;
    z-index: 1;
    right: 63px;
    top: 6px;
    outline-style: none;
    background-position: initial initial;
    background-repeat: no-repeat no-repeat
}


#nav-searchbar .nav-searchfield-width {
    background-image: url(/skin1_kolin/images/new/home/search.png);
    box-sizing: border-box;
    height: 35px;
    overflow: hidden;
    width: auto;
    background-position: left 0 top 3px;
    background-repeat: no-repeat no-repeat
}

#nav-searchbar #nav-iss-attach {
    height: 100%;
    padding: 0;
    position: relative;
    white-space: normal
}

#nav-searchbar #twotabsearchtextbox {
    background-image: none;
    background-attachment: scroll;
    background-color: transparent;
    border: 0 none;
    box-shadow: none;
    box-sizing: border-box;
    color: rgb(51, 51, 51);
    font-family: arial, sans-serif;
    font-size: 13px;
    height: 23px;
    left: 0;
    margin: 0;
    outline: rgb(0, 0, 0) none;
    padding: 0 0 0 8px;
    position: absolute;
    top: 7px;
    width: 500px;
    background-position: 0 0;
    background-repeat: repeat repeat
}


.header_line2 {
    height: 89px;
    width: 960px
}

.header_line3 {
    position: relative;
    top: -4px;
    height: 40px;
    width: 100%;
    background-color: #0072BB;
}

.product_search {
    font-family: Verdana;
    font-weight: bold;
    font-size: 20px;
    color: #ffffff;
    padding-right: 10px;
}

td.DialogTitle {
    COLOR: #CC3333;
    FONT-SIZE: 16px;
    BACKGROUND-COLOR: #ffffff;
    VERTICAL-ALIGN: bottom;
    HEIGHT: 15px;
    PADDING-TOP: 0px;
    PADDING-BOTTOM: 0px;
    PADDING-LEFT: 10px;
    PADDING-RIGHT: 0px;
    TEXT-ALIGN: left;
}

.header_line2_table {
    BACKGROUND: url(/skin1_kolin/images/new/home/banner.png) no-repeat bottom right;
}

.ui-tabs .ui-tabs-hide { display: none !important; }


