{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es5",
    "lib": ["es2019", "dom"],
    "removeComments": true,
    "baseUrl": "./",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      //административная часть
      "@admin/icons/*": [
        "backend/jsx/modules/common/components/icons/*",
      ],
      "@admin/modules/*": [
        "backend/jsx/modules/*",
      ],
      "@admin/*": [
        "backend/jsx/*",
      ],
      "@redux/*": [
        "backend/jsx/redux/*"
      ],
      "@s3stores-mail/*": [
        "backend/jsx/modules/s3stores-mail/*"
      ],

      //клиентская часть
      "@client/modules/*": [
        "frontend/jsx/modules/*"
      ],

      "@client/redux/*": [
        "frontend/redux/*"
      ],

      "@client/*": [
        "frontend/*"
      ],

      //common part
      "@local_modules/*": [
        "local_modules/*"
      ]
    },
    "jsx": "react"
  },
}
