{
  "compileOnSave": true,

  "compilerOptions": {
    "target": "es5",
    "lib": ["es2019"],
    "removeComments": true,
    "baseUrl": "./",
    "sourceMap": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      //административная часть
      "@admin/modules/*": [
        "backend/jsx/modules/*",
      ],
      "@admin/*": [
        "backend/jsx/*",
      ],

      //клиентская часть
      "@modules/*": [
        "frontend/jsx/modules/*"
      ],
      "@redux/*": [
        "backend/jsx/redux/*"
      ],
      "@s3stores-mail/*": [
        "backend/jsx/modules/s3stores-mail/*"
      ]
    },
    "jsx": "react"
  }
}
