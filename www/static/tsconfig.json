{
  "compileOnSave": true,
  "compilerOptions": {
    "target": "es5",
    "removeComments": true,
    "baseUrl": "./",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@modules/*": [
        "frontend/jsx/modules/*"
      ],
      "@modules/admin/*": [
        "backend/jsx/modules/*"
      ]
    },
    "jsx": "react"
  }
}
