            "Xcart\\External_Marketplaces\\": "www/modules/External_Marketplaces/include",
            "Omnipay\\BluePay\\" : "app/Modules/Payment/Gateways/Omnipay/BluePay",
            "Omnipay\\PayPal\\" : "app/Modules/Payment/Gateways/Omnipay/PayPal"
        },
        "classmap": [
            "app/include/vendors/caponica/amazon-mws-complete/src/AmazonPhpClientLibrary/FBAOutboundServiceMWS",
            "app/include/vendors/caponica/amazon-mws-complete/src/AmazonPhpClientLibrary/MarketplaceWebService",
            "app/include/vendors/caponica/amazon-mws-complete/src/AmazonPhpClientLibrary/FBAInventoryServiceMWS",
            "app/include/templater/templater.php",
            "app/include/smarty/Smarty.class.php",
            "app/include/smarty/Smarty_Compiler.class.php",
            "app/include/smarty/Config_File.class.php"
        ],
        "files": [
            "app/include/func/func.core.php",
            "app/include/func/func.amazon.php",
            "app/include/func/func.backoffice.php",
            "app/include/func/func.cart.php",
            "app/include/func/func.category.php",
            "app/include/func/func.clean_urls.php",
            "app/include/func/func.crypt.php",
            "app/include/func/func.db.php",
            "app/include/func/func.export.php",
            "app/include/func/func.files.php",
            "app/include/func/func.fraud.php",
            "app/include/func/func.froogle.php",
            "app/include/func/func.gd.php",
            "app/include/func/func.http.php",
            "app/include/func/func.https_curl.php",
            "app/include/func/func.https_httpscli.php",
            "app/include/func/func.https_libcurl.php",
            "app/include/func/func.https_openssl.php",
            "app/include/func/func.https_ssleay.php",
            "app/include/func/func.image.php",
            "app/include/func/func.import.php",
            "app/include/func/func.mail.php",
            "app/include/func/func.order.php",
            "app/include/func/func.order_edit.php",
            "app/include/func/func.payment.php",
            "app/include/func/func.product.php",
            "app/include/func/func.snapshots.php",
            "app/include/func/func.taxes.php",
            "app/include/func/func.templater.php",
