{
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "vendor-dir": "app/include/vendors"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/tsukasa-mixer/QueryBuilder"
        },
        {
            "type": "vcs",
            "url": "https://github.com/tsukasa-mixer/fenom"
        }
    ],
    "require": {
        "aws/aws-sdk-php": "^2.8",
        "caponica/amazon-mws-complete": "dev-master",
        "cocur/slugify": "^3.0",
        "dariuszp/cli-progress-bar": "^1.0",
        "fenom/fenom": "^2.11",
        "gabrielbull/ups-api": "^0.8.0",
        "geoip2/geoip2": "^2.7",
        "google/apiclient": "^2.0",
        "guzzlehttp/guzzle": "^6.3",
        "hellogerard/jobby": "^3.3",
        "imagine/imagine": "^0.7.1",
        "jaybizzle/crawler-detect": "^1.2",
        "league/flysystem": "^1.0",
        "mindy/query_builder": "dev-master_5.4",
        "mobiledetect/mobiledetectlib": "^2.8",
        "monolog/monolog": "^1.22",
        "omnipay/paypal": "v2.6.3",
        "paypal/rest-api-sdk-php": "*",
        "swiftmailer/swiftmailer": "^6",
        "symfony/http-foundation": "^2.8",
        "symfony/polyfill-mbstring": "^1.6",
        "symfony/validator": "^2.8",
        "theiconic/php-ga-measurement-protocol": "^2.7",
        "true/punycode": "^2.1"
    },
    "autoload": {
