#!/bin/bash
flag="/home/feeds/amazon_itn_feeds.flg"
if [ -e /home/feeds/amazon_itn_feeds.flg ]
then
    echo "Already running..."
    
else
    echo " " >> /home/feeds/amazon_itn_feeds.flg
    rm /home/feeds/amazon_itn_progress.txt
    echo " " >> /home/feeds/amazon_itn_progress.txt
    echo "Start processing" >> /home/feeds/amazon_itn_progress.txt
    cd /var/www/stores/cron
    php5 ./cron_amazon_tracking_number.php >> /home/feeds/amazon_itn_progress.txt

    echo " " >> /home/feeds/amazon_itn_progress.txt
    echo "Finish processing" >> /home/feeds/amazon_itn_progress.txt
    rm /home/feeds/amazon_itn_feeds.flg
fi

