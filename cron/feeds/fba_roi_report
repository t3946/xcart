#!/bin/bash
flag="/home/feeds/fba_roi_report.flg"
if [ -e /home/feeds/fba_roi_report.flg ]
then
    echo "Already running..."
    
else
    echo " " >> /home/feeds/fba_roi_report.flg
    rm /home/feeds/fba_roi_report_progress.txt
    echo " " >> /home/feeds/fba_roi_report_progress.txt
    echo "Start processing" >> /home/feeds/fba_roi_report_progress.txt
    cd /var/www/stores/cron/
    php5 ./cron_amazon_inventory_receipts.php >> /home/feeds/fba_roi_report_progress.txt

    echo " " >> /home/feeds/fba_roi_report_progress.txt
    echo "Finish processing" >> /home/feeds/fba_roi_report_progress.txt
    rm /home/feeds/fba_roi_report.flg
fi

