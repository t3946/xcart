	User profile page
*/
.RegSectionTitle {
	COLOR: #000000;
	FONT-SIZE: 13px;
	FONT-WEIGHT: bold;
}

/*
	Popup image
*/
.PImageImageCell {
	PADDING: 5px;
	TEXT-ALIGN: center;
	VERTICAL-ALIGN: middle;
	HEIGHT: 100%;
}
.PImageImageCell IMG {
	TEXT-ALIGN: center;
	VERTICAL-ALIGN: middle;
}

.PImageNumbersCell {
