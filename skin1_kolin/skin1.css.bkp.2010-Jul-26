	width: 172px;
	padding: 0px 20px 0px 0px;
}

table.SearchTable td.SearchTableRightColumn {
	width: 172px;
	padding: 0px 0px 0px 20px;
}

div.SearchContainer {
	margin: 10px 10px 0px; 
