<div class="spinner product_attr quantity clearfix" data-trigger="spinner">
    <a data-spin="down" rel="nofollow" class="oper reduce" href="#"></a>
    <input data-rule="quantity" data-min="0" data-start="{$min}" data-max="{$max}" data-step="{$step}" type="text" value="0" class="quantity" name="amount">
    <a data-spin="up" rel="nofollow" class="oper add" href="#"></a>
</div>